# BuBot .gitignore

# Python caches
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/

# BuBot Index Store and Generated Cache
index_store/
models/

# Eval artifacts & outputs
eval/results/*.csv
eval/results/*.json
eval/results/*.png
!eval/results/.gitkeep

# Pytest & Coverage
.pytest_cache/
.coverage
htmlcov/

# Operating System Files
.DS_Store
Thumbs.db

